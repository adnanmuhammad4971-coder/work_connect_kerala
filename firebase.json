{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "hosting": {
    "site": "workconnectkerala",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "jazeera-733f3",
          "appId": "1:798557170930:android:fcec33e5726661cb85b46b",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "jazeera-733f3",
          "configurations": {
            "android": "1:798557170930:android:fcec33e5726661cb85b46b",
            "ios": "1:798557170930:ios:5f117f65dfe7ef3485b46b",
            "macos": "1:798557170930:ios:5f117f65dfe7ef3485b46b",
            "web": "1:798557170930:web:25164a10bddcfd9885b46b",
            "windows": "1:798557170930:web:0c16029760f1cb3e85b46b"
          }
        }
      }
    }
  }
